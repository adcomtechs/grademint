{
  "name": "gpa-pro",
  "version": "2.0.0",
  "private": true,
  "description": "GPA Pro — a high-performance, framework-free GPA calculator web application with customizable grading systems, real-time computation, and persistent client-side storage built using modern JavaScript.",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.19.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:ci": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\""
  },
  "keywords": [
    "gpa calculator",
    "grade calculator",
    "cgpa calculator",
    "academic tools",
    "student utilities",
    "javascript app",
    "vanilla js",
    "saas tool",
    "web app"
  ],
  "author": "Adcomtechs",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-boundaries": "^6.0.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
